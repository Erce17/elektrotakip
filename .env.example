DATABASE_URL=postgresql://localhost:5432/elektrotakip
# En az 32 karakter olmali; ornek deger birakilirsa uygulama acilmaz.
# Uret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<buraya-rastgele-uzun-string>
# Uretimde (HTTPS) true yap; lokalde http kullanildigi icin false kalir.
# true iken Strict-Transport-Security basligi da gonderilir.
COOKIE_SECURE=false
